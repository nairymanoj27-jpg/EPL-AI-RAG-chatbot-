# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in your own values.
# Never commit `.env`. Nothing here is a real credential.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Premier League Stats RAG Chatbot
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Pinecone (required)
# ---------------------------------------------------------------------------
# The data-plane API key that can query the existing index. Read-only use is
# enough; the app never upserts, updates, or deletes vectors.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Optional but recommended: the index host from the Pinecone console
# (for example `my-index-abc123.svc.aped-1234.pinecone.io`). Using the host
# avoids a control-plane lookup on the first query.
PINECONE_HOST=

# Namespace that contains the vectors. Leave empty for the default namespace.
# The literal value `__default__` is also accepted and normalised to empty.
PINECONE_NAMESPACE=

# Must exactly match the model and parameters used during ingestion.
# `multilingual-e5-large` uses `input_type="passage"` at ingest time and
# `input_type="query"` for queries; the app handles the query side.
PINECONE_EMBED_MODEL=multilingual-e5-large

# Metadata field that contains the chunk text.
PINECONE_TEXT_FIELD=text
PINECONE_TEXT_FIELD_FALLBACKS=chunk_text,content,page_content

# Expected dense-vector dimension of the index (multilingual-e5-large = 1024).
# Set to `none` only if you intentionally want to skip the dimension check.
EMBEDDING_DIMENSION=1024

# Expected index metric: cosine, dotproduct, or euclidean. Used for readiness
# warnings and threshold handling. Set to `none` to skip the check.
EXPECTED_METRIC=cosine

# ---------------------------------------------------------------------------
# Google Gemini (required)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# ---------------------------------------------------------------------------
# Retrieval and prompt limits
# ---------------------------------------------------------------------------
TOP_K=5
# Optional similarity floor. Leave empty until you have calibrated it against
# real questions. Set to `none` or leave empty to disable. For cosine, higher is
# better; euclidean uses lower-is-better.
MIN_RELEVANCE_SCORE=
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARACTERS=12000
MAX_QUESTION_CHARACTERS=2000
MAX_TOP_K=20
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_BYTES=65536

# ---------------------------------------------------------------------------
# HTTP and security
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. The built-in /ui is
# same-origin and does not need to be listed.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional application API key. When set, clients must send `X-API-Key`.
# The key is never sent to Gemini or Pinecone.
APP_API_KEY=

# POST /retrieve exposes raw indexed text. Disable it in public deployments
# unless the API is authenticated.
ENABLE_RETRIEVE_ENDPOINT=true
SERVE_FRONTEND=true

# ---------------------------------------------------------------------------
# Conversation memory
# ---------------------------------------------------------------------------
# sqlite = multi-turn context stored locally; none = stateless.
CONVERSATION_STORAGE=sqlite
CONVERSATION_DB_PATH=data/conversations.sqlite3
# Maximum number of recent user/assistant messages included as context.
CONVERSATION_MAX_TURNS=6
CONVERSATION_MAX_CHARACTERS=6000

# Cache /ready results for this many seconds (0 disables caching).
READINESS_CACHE_SECONDS=60
